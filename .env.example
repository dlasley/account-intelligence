# Copy to .env and fill in real values. Never commit .env.
#
# Nothing here is required to run `uv run pytest`, `npm test`, `ingest-fixtures`,
# `synthesise-fixtures`, or boot `serve` (routes read their own env lazily per-request,
# not at startup) — see the README's "Run It Locally, No Accounts" section. Every
# variable below is annotated with the specific subcommand/route that reads it; nothing
# is "required" in a blanket sense.

# --- LLM providers ---
ANTHROPIC_API_KEY=       # generate-narratives only — Claude API call. Not read by serve, process-fixtures, or the tests.
FAKE_LLM=false           # generate-narratives only — set true to use a canned local stub instead of ANTHROPIC_API_KEY (no outbound call). Same effect as passing --fake-llm; the flag wins if both are set. See src/pipeline/dev_fake_llm.py — never point scripts/audit_narratives.py at this output.
OPENAI_API_KEY=          # audit harness only — cross-vendor narrative auditor (GPT-5-mini); see scripts/audit_narratives.py. Not read anywhere in the worker's serving path.
AUDIT_MAX_COST_USD=0.50  # audit harness only — cost ceiling for one run; scripts/audit_narratives.py defaults to 0.50 if unset

# --- Supabase (Python worker + MCP) ---
# Required to boot anything that touches the DB: process-fixtures, generate-narratives,
# and any serve route beyond GET /health. For local development these can point at a
# `supabase start` stack instead of a hosted project — see the README.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=   # MCP server only (not used by worker at runtime)
SUPABASE_PROJECT_REF=    # MCP server only — substituted into .mcp.json URLs. Must be exported in process env (~/.zshenv on macOS so the VS Code GUI inherits it), not just .env.

# --- Supabase (Next.js frontend — same project, different key prefix) ---
# NEXT_PUBLIC_ prefix is required for Next.js to expose values to the client bundle.
NEXT_PUBLIC_SUPABASE_URL=        # same value as SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # same value as SUPABASE_ANON_KEY
NEXT_PUBLIC_WORKER_URL=          # Cloud Run service URL, e.g. https://csp-worker-xxxxx.us-central1.run.app (leave empty for local dev when running worker on :8080 with a proxy)

# --- Inbound email ---
INBOUND_DOMAIN=signal.example.com   # e.g. signal.yourdomain.com — public placeholder; production value set in deploy env

# --- HTTP server ---
# `serve` boots fine with none of these set; each is read lazily inside its own route
# handler and only matters once that specific route is called.
WEBHOOK_SECRET=        # POST /inbound only — set to a random 32-char string; passed as ?token=<VALUE> query param (SendGrid Inbound Parse doesn't support custom headers)
SCHEDULER_SECRET=      # POST /run-narratives and /run-polls only — set to a random 32-char string; passed as Authorization: Bearer header by Cloud Scheduler
INTEGRATION_ENCRYPTION_KEY=   # POST /signal/{kind} and the Granola poller only (Plain/Pylon/Granola credential encryption, ADR-020) — read lazily per-request/per-poll, not at worker startup, so the worker boots fine without it if no structured integrations are configured. 32-byte random value, base64-encoded. Generate: python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
SENDGRID_API_KEY=      # POST /outreach/send only — SendGrid Transactional API key
CORS_ORIGINS=          # All routes, optional — comma-separated allowed origins, e.g. http://localhost:3000 (local) or https://your-app.vercel.app (prod). Unset = no CORS headers.
FASTAPI_DEBUG=         # serve only, optional — set to "true" to enable /docs UI locally
LOG_LEVEL=             # All commands, optional — defaults to WARNING; set to INFO for Cloud Run

# --- PostHog analytics + LLM observability (worker) ---
# Both product analytics (src/analytics.py) and LLM observability (src/observability/llm.py)
# use the same API key + host.  See docs/architecture.md for the boundary between them.
POSTHOG_API_KEY=           # PostHog project API key (same value as NEXT_PUBLIC_POSTHOG_KEY)
POSTHOG_HOST=              # e.g. https://us.i.posthog.com
POSTHOG_ENABLED=false      # product analytics on/off; true in prod, false locally
POSTHOG_LLM_OBSERVABILITY_ENABLED=true  # LLM OTel instrumentation; on by default when POSTHOG_API_KEY is set
DEPLOY_ENV=development     # injected into OTel resource attributes; set to "production" in prod
APP_ENV=                   # product analytics distinct_id prefix; set to "production" in prod

# --- PostHog analytics (Next.js frontend) ---
NEXT_PUBLIC_POSTHOG_KEY=         # PostHog project API key
NEXT_PUBLIC_POSTHOG_HOST=        # e.g. https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_ENABLED=false  # true in prod; false locally
